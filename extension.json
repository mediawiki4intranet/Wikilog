        "BeforePageDisplay": "Wikilog::BeforePageDisplay",
        "ArticleFromTitle": "Wikilog::ArticleFromTitle",
        "ParserFirstCallInit": "WikilogParser::FirstCallInit",
        "ArticleEditUpdates": "WikilogHooks::ArticleEditUpdates",
        "DatabaseSchemaUpdates": "WikilogHooks::onDatabaseSchemaUpdates",
        "ParserStart": "WikilogParser::onParserStart",
        "InternalParseBeforeSanitize": "WikilogParser::onInternalParseBeforeSanitize",
        "ParserClearState": "WikilogParser::onParserClearState"
